# VibeHealth settings. EVERY variable here is optional: a fresh install runs with none of them,
# and most things can be set in the app (setup guide, Settings page). A setting saved in the app
# wins over the environment, and the environment wins over the built-in default.
#
# Use:  cp .env.example .env   then uncomment what you need (compose.yaml: `env_file`),
#       or point a Podman Quadlet at the file (deploy/vibehealth.container).
# Keep the copy private (chmod 600). Never commit it. No real values belong in this example file.

# --- Secrets ------------------------------------------------------------------------------------

# Root secret: session signing and the encryption of saved secrets (the Paperless token) derive from
# it. Left empty, a random key is created once and kept in the data folder (/data/.keys/master.key),
# which is fine as long as the whole data folder is backed up together.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later signs everyone out and makes saved secrets unreadable (enter them again).
# SECRET_KEY=

# Password hash, made with:  docker compose exec vibehealth python -m app.security
# You do not need this: the setup guide sets the password for you (first run needs the setup code
# from `docker compose logs vibehealth`). A password set in the app wins over this variable.
# New passwords need at least 10 characters.
# APP_PASSWORD_HASH=

# A new installation is unusable until a password is set. 1 keeps an installation WITHOUT a password
# open (the whole API, no login): only for an install that predates passwords. Not recommended.
# It has no effect once a password exists.
# VIBEHEALTH_LEGACY_OPEN=1

# --- Where the documents come from (all optional; you can also just upload files) ----------------

# Paperless-ngx as seen from the container (not 127.0.0.1: that is the container itself).
# PAPERLESS_URL=http://host.docker.internal:8000
# Paperless as seen from your browser, for links. Empty: PAPERLESS_URL is used.
# PAPERLESS_PUBLIC_URL=https://paperless.example.com
# API token created in Paperless. Prefer entering it in the app (it is stored encrypted and is
# write-only); use this only if you must configure it from the environment.
# PAPERLESS_TOKEN=
# Which documents are synced: the document type, and/or these tags (JSON list).
# PAPERLESS_DOCUMENT_TYPE=Medical
# PAPERLESS_TAGS=["Blood Test","Medical Report","Prescription","Imaging"]
# Minutes between automatic syncs (0: only "Sync now").
# SYNC_INTERVAL_MINUTES=240

# --- Reading lab values with Ollama (defaults for the Settings page) -----------------------------

# Where Ollama listens, seen from the container. The default reaches Ollama on the host
# (compose.yaml adds host.docker.internal). With the bundled compose service use http://ollama:11434.
# OLLAMA_URL=http://host.docker.internal:11434
# READING_ENABLED=true
# READER_A_MODEL=qwen3.5:4b
# READER_B_ENABLED=true
# READER_B_MODEL=glm-ocr
# READING_DPI=150
# READING_FALLBACK_DPIS=[100,200]
# OLLAMA_NUM_CTX=8192
# OLLAMA_TIMEOUT_SECONDS=300
# OLLAMA_KEEP_ALIVE=5m
# Also use Paperless's own OCR text as a third opinion.
# USE_PAPERLESS_TEXT=true
# Queue newly synced documents for reading automatically.
# AUTO_READ_AFTER_SYNC=false

# --- General ---------------------------------------------------------------------------------------

# Interface language: en or el. The language chosen in the app wins.
# DEFAULT_LANGUAGE=en
# Days a sign-in lasts.
# SESSION_DAYS=30

# --- Behind a reverse proxy (see "Exposing safely" in the README) ---------------------------------

# 1: believe X-Forwarded-Proto/Host/For from a proxy you run that terminates TLS
# (the cookie becomes Secure, client addresses are right). Only with a proxy in front.
# VIBEHEALTH_TRUST_PROXY=1
# Extra host names the app answers to (comma separated), e.g. the public name of your proxy.
# IPs, localhost, single-label names and *.local, *.lan, *.home.arpa, *.internal, *.ts.net are allowed already.
# VIBEHEALTH_ALLOWED_HOSTS=health.example.com
# Extra origins allowed to send changes (JSON list), e.g. the proxy's public origin.
# TRUSTED_ORIGINS=["https://health.example.com"]
# Host address the container's port is published on. compose.yaml sets it from VIBEHEALTH_BIND (default
# 127.0.0.1) and the Quadlet has it next to PublishPort, so you normally never set it yourself. The
# start-up warnings about listening on 0.0.0.0 are skipped only when it is a loopback address
# (127.0.0.0/8, ::1, localhost); anything else, or unset, keeps them.
# VIBEHEALTH_PUBLISHED_ON=127.0.0.1
# compose.yaml only: the address to publish the port on (default 127.0.0.1, this machine only).
# Example for a LAN address:  VIBEHEALTH_BIND=192.0.2.10   (read "Exposing safely" in the README first).
# VIBEHEALTH_BIND=127.0.0.1
# Only for the start-up warning, when the listen address cannot be read from --host.
# VIBEHEALTH_HOST=

# --- Uploads sandbox ---------------------------------------------------------------------------------

# Memory limit (MB) of the short-lived child process that opens uploaded PDFs and images. 0: none.
# VIBEHEALTH_SANDBOX_MEMORY_MB=2048

# --- Development and special cases (leave alone in normal use) ---------------------------------------

# 1: serve /docs, /redoc, /openapi.json. They describe every endpoint to anyone who can reach the app.
# VIBEHEALTH_DEV_DOCS=1
# The app must run as ONE process: it refuses to start with more workers. 1 turns that into a warning.
# VIBEHEALTH_ALLOW_MULTIPLE_WORKERS=1
# Where the data lives inside the container. The image sets /data; change the volume, not this.
# DATA_DIR=/data
